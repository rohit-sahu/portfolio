# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# secrets (docker compose secrets, e.g. cloudflare tunnel token)
/secrets/*
!/secrets/*.example

# local read-through cache for resume content (see src/lib/resume-data.ts) —
# generated at runtime, not source
/data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
